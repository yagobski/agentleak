# AgentLeak Cloud — production environment.
# Copy to `.env` and adjust. Never commit the real .env.
#
#   cp .env.production.example .env

# --- Public SaaS mode -------------------------------------------------------
# Turns on the hosted-service defaults (quota, throttle, BYOK, secure cookies).
# docker-compose already sets this; listed here for bare-metal/systemd runs.
AGENTLEAK_PUBLIC_MODE=1

# --- Free-tier limits (override the public-mode defaults if you like) -------
# Metered actions per account per calendar month. 0 = unlimited.
AGENTLEAK_FREE_MONTHLY_QUOTA=1000
# New sign-ups allowed per client IP per hour.
AGENTLEAK_REGISTER_IP_LIMIT=10
# Global requests per client IP per minute (DoS guard).
AGENTLEAK_IP_RATE_LIMIT=240

# --- BYOK / cost control ----------------------------------------------------
# 1 = the platform never uses its own LLM key for a tenant's run (recommended
# for a free public service). Leave the platform LLM keys UNSET below.
AGENTLEAK_FORCE_BYOK=1
# Do NOT set OPENROUTER_API_KEY / AGENTLEAK_LLM_* on a public free instance —
# with FORCE_BYOK=1 they are ignored anyway, but keep them unset to be safe.

# --- Transport / cookies ----------------------------------------------------
# Send session cookies only over HTTPS. The reverse proxy terminates TLS, so
# this must be 1 in production.
AGENTLEAK_COOKIE_SECURE=1

# --- Build ------------------------------------------------------------------
# gui  = fastapi + uvicorn (regex/entropy/de-obfuscation detection) — lean.
# full = also Presidio + spaCy (hybrid NER detection) — larger image.
AGENTLEAK_EXTRAS=gui

# --- Storage ----------------------------------------------------------------
# Where the SQLite DB lives inside the container (mounted volume). Leave as-is.
AGENTLEAK_HOME=/data
