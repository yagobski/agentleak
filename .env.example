# ── Cloud providers ───────────────────────────────────────────────────────
# OpenRouter (default — gives access to GPT-4o-mini, Claude, Llama, etc.)
OPENROUTER_API_KEY=sk-or-v1-...

# Or use OpenAI directly
# OPENAI_API_KEY=sk-...

# Or Groq (fast, cheap)
# GROQ_API_KEY=gsk_...

# ── Local inference — no API key required ─────────────────────────────────
# Ollama  (brew install ollama && ollama pull llama3.2)
# In project Settings → Live agent endpoint → Ollama preset, or:
#   AGENTLEAK_LLM_BASE_URL=http://localhost:11434/v1
#   AGENTLEAK_LLM_MODEL=llama3.2

# LM Studio  (lmstudio.ai — start the local server on port 1234)
# In project Settings → Live agent endpoint → LM Studio preset, or:
#   AGENTLEAK_LLM_BASE_URL=http://localhost:1234/v1
#   AGENTLEAK_LLM_MODEL=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF

# ── Optional global model override ────────────────────────────────────────
# Overrides the default model chosen by _resolve_redteam_llm when a
# base URL is set but the project hasn't configured a specific model.
# AGENTLEAK_LLM_MODEL=openai/gpt-4o-mini

# ── Security ──────────────────────────────────────────────────────────────
# Set to 1 when serving the platform over HTTPS (production / non-localhost).
# Adds the Secure flag to the session cookie and enables HSTS headers.
# AGENTLEAK_COOKIE_SECURE=1
