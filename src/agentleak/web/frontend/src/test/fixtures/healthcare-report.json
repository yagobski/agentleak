   "advice": "Apply least-privilege data sharing between agents; only pass what the receiving agent strictly needs.",
   "code_fix": "# Keys allowed to cross agent boundaries (allowlist beats denylist)\nAGENT_HANDOFF_ALLOWLIST = {'task_id', 'intent', 'status', 'result_summary'}\n\ndef clean_handoff(payload: dict) -> dict:\n    \"\"\"Strip keys not on the allowlist before sending to the next agent.\"\"\"\n    return {k: v for k, v in payload.items() if k in AGENT_HANDOFF_ALLOWLIST}\n\n# LangGraph / CrewAI example:\n# next_agent.run(clean_handoff(current_state))\n"
